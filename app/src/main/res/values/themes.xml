<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Material 3 theme. The Activity overrides status/nav bar
         colors at runtime via enableEdgeToEdge(); the theme just needs
         to exist for the system to find it. -->
    <style name="Theme.CH341Bridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
